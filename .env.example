# 数据库：默认开发态由 scripts/dev.mjs 启动 embedded-postgres 并注入；也可指向外部 PostgreSQL 16
DATABASE_URL=postgresql://localhost:5432/rabbit
# Redis：默认开发态使用本机 6379（dev 脚本会用 Docker 拉起）
REDIS_URL=redis://127.0.0.1:6379
# web 应用
WEB_URL=http://localhost:3000
# 会话加密密钥（≥32 字符）
SESSION_SECRET=change-me-to-a-random-32-chars-secret!
# web 与 engine 内部回调/注册令牌
INTERNAL_TOKEN=change-me-internal-token
# MinIO（compose 模式使用，P0 代码未使用）
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
