  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="UIT-003 UI 测试脚本模式（CRUD/校验干跑/执行/trace；四类场景）">
      <stringProp name="TestPlan.comments">S13 UIT-003 §5 T6-T8：脚本用例 CRUD 四类（正常/401/404/422/分页）+ validate-script 干跑两态 + 执行主链（测试树行+trace fileId）。ENTP-009 开源全功能：无 License 门控。</stringProp>
