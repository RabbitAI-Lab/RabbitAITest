        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="T1-1 新建脚本用例（mode=script，mock /uit/demo 两测试）">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&quot;name&quot;:&quot;jm-脚本用例${TS}&quot;,&quot;mode&quot;:&quot;script&quot;,&quot;steps&quot;:[],&quot;script&quot;:&quot;import { test, expect } from '@playwright/test';\ntest('脚本提交成功', async ({ page }) =&gt; {\n  await page.goto('http://${__P(MOCKHOST,127.0.0.1)}:${__P(MOCKPORT,4020)}/uit/demo');\n  await page.getByTestId('demo-username').fill('jm-uit3');\n  await page.getByTestId('demo-submit').click();\n  await expect(page.getByTestId('demo-result')).toContainText('提交成功，jm-uit3');\n});\ntest('元素可见', async ({ page }) =&gt; {\n  await page.goto('http://${__P(MOCKHOST,127.0.0.1)}:${__P(MOCKPORT,4020)}/uit/demo');\n  await expect(page.getByTestId('demo-username')).toBeVisible();\n});&quot;,&quot;params&quot;:[{&quot;key&quot;:&quot;BASEURL&quot;,&quot;value&quot;:&quot;http://example&quot;}],&quot;timeoutMs&quot;:30000}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.domain">${__P(HOST,localhost)}</stringProp>
          <stringProp name="HTTPSampler.port">${__P(PORT,3100)}</stringProp>
          <stringProp name="HTTPSampler.path">/api/v1/projects/${PROJECT_ID}/ui-cases</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
