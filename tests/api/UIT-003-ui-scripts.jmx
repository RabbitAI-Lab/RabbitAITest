            <stringProp name="Argument.name">EMAIL_G1</stringProp>
            <stringProp name="Argument.value">jm-uit3-g1-${__time(yyyyMMddHHmmss)}@rabbit.test</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="EMAIL_G2" elementType="Argument">
            <stringProp name="Argument.name">EMAIL_G2</stringProp>
            <stringProp name="Argument.value">jm-uit3-g2-${__time(yyyyMMddHHmmss)}@rabbit.test</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="EMAIL_G3" elementType="Argument">
            <stringProp name="Argument.name">EMAIL_G3</stringProp>
            <stringProp name="Argument.value">jm-uit3-g3-${__time(yyyyMMddHHmmss)}@rabbit.test</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
