  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="API-004 参数体系（变量/断言/提取/前后置）">
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments">
        <collectionProp name="Arguments.arguments">
          <elementProp name="EMAIL" elementType="Argument">
            <stringProp name="Argument.name">EMAIL</stringProp>
            <stringProp name="Argument.value">jm-api004-${__time(yyyyMMddHHmmss)}-${__threadNum}@rabbit.test</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="TS" elementType="Argument">
            <stringProp name="Argument.name">TS</stringProp>
            <stringProp name="Argument.value">${__time(yyyyMMddHHmmss)}</stringProp>
