          <elementProp name="EMAIL" elementType="Argument">
            <stringProp name="Argument.name">EMAIL</stringProp>
            <stringProp name="Argument.value">jm-exec002-${__time(yyyyMMddHHmmss)}-${__threadNum}@rabbit.test</stringProp>
