            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&quot;type&quot;:&quot;api_debug&quot;,&quot;clientTaskId&quot;:&quot;jm-i4004-${__time(yyyyMMddHHmmss)}&quot;,&quot;request&quot;:{&quot;method&quot;:&quot;GET&quot;,&quot;url&quot;:&quot;${__P(MOCK_URL)}&quot;,&quot;headers&quot;:[],&quot;query&quot;:[],&quot;body&quot;:{&quot;kind&quot;:&quot;none&quot;},&quot;auth&quot;:{&quot;kind&quot;:&quot;none&quot;},&quot;timeoutMs&quot;:10000,&quot;followRedirects&quot;:false,&quot;skipPre&quot;:false,&quot;skipPost&quot;:false},&quot;asserts&quot;:[{&quot;kind&quot;:&quot;status_code&quot;,&quot;path&quot;:&quot;&quot;,&quot;op&quot;:&quot;eq&quot;,&quot;expected&quot;:&quot;500&quot;}],&quot;pre&quot;:[],&quot;post&quot;:[],&quot;extracts&quot;:[]}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.domain">${__P(HOST,localhost)}</stringProp>
          <stringProp name="HTTPSampler.port">${__P(PORT,3100)}</stringProp>
          <stringProp name="HTTPSampler.path">/api/v1/projects/${PROJ_ID}/exec-tasks</stringProp>
