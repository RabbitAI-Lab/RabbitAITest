        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="T2.1 不存在任务 run → 404 40520（404 类）">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments"/>
          <stringProp name="HTTPSampler.domain">${__P(HOST,localhost)}</stringProp>
          <stringProp name="HTTPSampler.port">${__P(PORT,3100)}</stringProp>
          <stringProp name="HTTPSampler.path">/api/v1/projects/${PROJECT_ID}/swagger-sync/not-exist/run</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">false</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="HTTP 404">
            <collectionProp name="Asserion.test_strings"><stringProp name="49586">404</stringProp></collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">true</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="code+msg 断言">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters">40520|:null}</stringProp>
            <stringProp name="script">def sep = Parameters.indexOf(&quot;|&quot;); def code = Parameters.substring(0, sep); def frag = Parameters.substring(sep + 1); def body = ctx.getPreviousResult().getResponseDataAsString(); def needle = &quot;:&quot; + code + &quot;,&quot;; if (!body.contains(needle) || !body.contains(frag)) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(&quot;expect &quot; + needle + &quot; &amp; &quot; + frag + &quot; got: &quot; + body.take(160)) }</stringProp>
          </JSR223Assertion>
          <hashTree/>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="&lt;5000ms">
            <stringProp name="DurationAssertion.duration">5000</stringProp>
          </DurationAssertion>
          <hashTree/>
        </hashTree>

