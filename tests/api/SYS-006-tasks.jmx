                <stringProp name="Argument.value">{&quot;email&quot;: &quot;${EMAIL}&quot;, &quot;password&quot;: &quot;rabbit-pass-123&quot;}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.domain">${__P(HOST,localhost)}</stringProp>
