// RabbitAITest 测试域统一数据模型（INFRA-003 一次建齐；来源 docs/architecture/test-domain-model.md §2）
// 规范：rules/database.md（snake_case 复数表名 / UUID 主键 / 软删 deletedAt / 乐观锁 version / 状态列 String+应用层 zod）

generator client {
  provider      = "prisma-client-js"
  // native=构建机；linux-*=Docker/CI（bookworm/ubuntu 均为 openssl 3）
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "linux-arm64-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── system 域 ─────────────────────────

model User {
  id           String    @id @default(uuid())
  email        String    @unique @db.VarChar(256)
  name         String    @db.VarChar(128)
  phone        String?   @db.VarChar(32)
  passwordHash String    @map("password_hash") @db.VarChar(512)
  status       String    @default("ACTIVE") @db.VarChar(32) // ACTIVE | DISABLED
  source       String    @default("LOCAL") @db.VarChar(32) // LOCAL | INVITE | LDAP...（ENTP 用）
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  orgMemberships     OrgMember[]
  ownedOrganizations Organization[]
  projectMembers     ProjectMember[]
  groupMembers       GroupMember[]
  apiKeys            ApiKey[]
  oauthGrants        OAuthGrant[]
  follows            Follow[]
  comments           Comment[]
  changeLogs         ChangeLog[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  departmentMembers  DepartmentMember[]
  scmAccounts        ScmAccount[]
  createdScmRepos    ScmRepository[]
}

model Organization {
  id          String    @id @default(uuid())
  name        String    @db.VarChar(128)
  description String?   @db.VarChar(512)
  ownerId     String    @map("owner_id")
  owner       User      @relation(fields: [ownerId], references: [id])
  status      String    @default("ACTIVE") @db.VarChar(32) // ACTIVE | ENDED
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  members      OrgMember[]
  projects     Project[]
  integrations PlatformIntegration[]
  departments  Department[]
  scmOrgApps   ScmOrgApp[]
  scmAccounts  ScmAccount[]
}

model OrgMember {
  id        String       @id @default(uuid())
  orgId     String       @map("org_id")
  org       Organization @relation(fields: [orgId], references: [id])
  userId    String       @map("user_id")
  user      User         @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now()) @map("created_at")

  @@unique([orgId, userId])
  @@index([userId])
  @@map("org_members")
}

model Project {
  id          String       @id @default(uuid())
  orgId       String       @map("org_id")
  org         Organization @relation(fields: [orgId], references: [id])
  name        String       @db.VarChar(128)
  num         Int // 组织内递增编号（advisory lock 分配）
  description String?      @db.VarChar(512)
  /// 开启的模块开关（Sprint 1 应用设置用；P0 全默认）
  modules     Json         @default("{\"case\":true,\"api\":true,\"plan\":true,\"bug\":true}")
  status      String       @default("ENABLED") @db.VarChar(32) // ENABLED | DISABLED | ENDED
  deletedAt   DateTime?    @map("deleted_at")
  purgeAt     DateTime?    @map("purge_at") // 软删后 30 天物理删除（Sprint 1）
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  members          ProjectMember[]
  moduleNodes      ModuleNode[]
  cases            FunctionalCase[]
  apiDefinitions   ApiDefinition[]
  apiCases         ApiCase[]
  scenarios        Scenario[]
  testPlans        TestPlan[]
  bugs             Bug[]
  environments     Environment[]
  envGroups        EnvGroup[]
  globalParams     GlobalParam[]
  fileItems        FileItem[]
  fileRepos        FileRepo[]
  publicScripts    PublicScript[]
  falseAlarmRules  FalseAlarmRule[]
  appSettings      AppSetting[]
  execTasks        ExecTask[]
  reports          Report[]
  robots           Robot[]
  messageTemplates MessageTemplate[]
  attachments      Attachment[]
  loadTests        LoadTest[]
  uiElements       UiElement[]
  uiCases          UiTestCase[]
  uiRunners        UiRunner[]
  scmRepositories  ScmRepository[]

  @@unique([orgId, num])
  @@index([deletedAt])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id])
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  role      String   @default("MEMBER") @db.VarChar(32) // OWNER | ADMIN | MEMBER（P0 简化角色；Sprint 1 换用户组）
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Group {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(128)
  scope       String   @db.VarChar(16) // system | org | project
  orgId       String?  @map("org_id")
  projectId   String?  @map("project_id")
  isSystem    Boolean  @default(false) @map("is_system")
  permissions Json     @default("[]") // 权限点数组（SYS-004）
  disabled    Json     @default("[]") // 禁用资源清单（rbac §1：任一所在组禁用即整体禁用）
  description String?  @db.VarChar(512)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members GroupMember[]

  @@index([scope])
  @@map("groups")
}

model GroupMember {
  id      String @id @default(uuid())
  groupId String @map("group_id")
  group   Group  @relation(fields: [groupId], references: [id])
  userId  String @map("user_id")
  user    User   @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@map("group_members")
}

model ResourcePool {
  id             String    @id @default(uuid())
  name           String    @db.VarChar(128)
  type           String    @default("NODE") @db.VarChar(16) // NODE | K8S（EXEC-004 兑现；ENTP-006 多池 License 门控）
  isDefault      Boolean   @default(false) @map("is_default")
  maxConcurrency Int       @default(4) @map("max_concurrency")
  /// 心跳与节点信息（P0 单节点：nodeId/version/slots/ts）
  nodes          Json      @default("[]")
  /// 应用组织：ALL | [orgId]（S9 ENTP-006；门禁 3 例外登记 test-domain-model §6）
  orgScope       Json      @default("\"ALL\"") @map("org_scope")
  /// K8S 型配置（EXEC-004：apiServer/namespace/token/image；token 只写不读）。
  /// 门禁 3 例外登记 test-domain-model §6：K8S 池配置结构在 EXEC-002 时点未冻结，Json 载体一次补齐
  config         Json      @default("{}")
  lastBeatAt     DateTime? @map("last_beat_at")
  status         String    @default("ACTIVE") @db.VarChar(32)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  execTasks ExecTask[]

  @@map("resource_pools")
}

model Plugin {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(128)
  kind        String   @db.VarChar(32) // protocol | platform | driver
  version     String   @db.VarChar(32)
  storageKey  String   @map("storage_key") @db.VarChar(512)
  orgScope    Json     @default("\"ALL\"") @map("org_scope") // ALL | [orgId]
  description String?  @db.VarChar(512)
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("plugins")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  scope      String   @db.VarChar(16) // system | org | project
  projectId  String?  @map("project_id")
  action     String   @db.VarChar(64)
  objectType String   @map("object_type") @db.VarChar(64)
  objectId   String?  @map("object_id") @db.VarChar(64)
  detail     Json?
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  type      String    @db.VarChar(64)
  title     String    @db.VarChar(256)
  content   String    @db.VarChar(2048)
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("notifications")
}

model Robot {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id])
  name      String   @db.VarChar(128)
  channel   String   @db.VarChar(32) // inapp | email | wecom | dingtalk | feishu
  webhook   String?  @db.VarChar(1024)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("robots")
}

/// 自定义消息模板（S9 ENTP-005；项目×事件唯一，无模板回退 MSG-001 默认文案。门禁 3 例外登记 test-domain-model §6）
model MessageTemplate {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id])
  event     String   @db.VarChar(48)
  title     String   @db.VarChar(128)
  content   String   @db.VarChar(1024)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([projectId, event])
  @@map("message_templates")
}

/// SSO 认证源（S9 ENTP-002/003；config 判别式存各协议字段，secrets 字段 AES-GCM 密文。门禁 3 例外登记 test-domain-model §6）
model AuthSource {
  id        String   @id @default(uuid())
  type      String   @db.VarChar(16) // LDAP | CAS | OIDC | OAUTH2 | SAML | WECOM | DINGTALK | FEISHU
  name      String   @db.VarChar(128)
  enabled   Boolean  @default(true)
  config    Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("auth_sources")
}

/// 组织级部门（S9 ENTP-008；树形（parentId 自引用）。门禁 3 例外登记 test-domain-model §6）
model Department {
  id                String             @id @default(uuid())
  orgId             String             @map("org_id")
  org               Organization       @relation(fields: [orgId], references: [id])
  parentId          String?            @map("parent_id")
  parent            Department?        @relation("DeptTree", fields: [parentId], references: [id])
  children          Department[]       @relation("DeptTree")
  name              String             @db.VarChar(64)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  departmentMembers DepartmentMember[]

  @@index([orgId, parentId])
  @@map("departments")
}

/// 部门成员（多对多：一人可属多部门。S9 ENTP-008）
model DepartmentMember {
  id           String     @id @default(uuid())
  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId       String     @map("user_id")
  user         User       @relation(fields: [userId], references: [id])
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([departmentId, userId])
  @@index([userId])
  @@map("department_members")
}

model ApiKey {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id])
  name       String    @db.VarChar(128)
  prefix     String    @db.VarChar(16)
  keyHash    String    @map("key_hash") @db.VarChar(128)
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")

  @@index([prefix])
  @@map("api_keys")
}

/// SYS-009：OAuth Device Flow 待授权码（RFC 8628；10 分钟一次性，status CONSUMED 防双花）
model OAuthDeviceCode {
  id             String    @id @default(uuid())
  clientId       String    @default("rabbit-cli") @map("client_id") @db.VarChar(64)
  deviceCodeHash String    @map("device_code_hash") @db.VarChar(128)
  userCode       String    @map("user_code") @db.VarChar(16)
  scope          String    @db.VarChar(64)
  status         String    @default("PENDING") @db.VarChar(16) // PENDING | APPROVED | DENIED | CONSUMED
  userId         String?   @map("user_id")
  ip             String?   @db.VarChar(64)
  userAgent      String?   @map("user_agent") @db.VarChar(256)
  approveFails   Int       @default(0) @map("approve_fails")
  expiresAt      DateTime  @map("expires_at")
  approvedAt     DateTime? @map("approved_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([deviceCodeHash])
  @@index([userCode])
  @@map("oauth_device_codes")
}

/// SYS-009：OAuth 授权会话（一次 device flow 登录=一行 family；refresh 旋转原行更新，
/// prevRefreshHash 保留旧值哈希——重放检测命中即整会话吊销）
model OAuthGrant {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id])
  clientId         String    @default("rabbit-cli") @map("client_id") @db.VarChar(64)
  deviceName       String?   @map("device_name") @db.VarChar(128)
  scope            String    @db.VarChar(64)
  status           String    @default("ACTIVE") @db.VarChar(16) // ACTIVE | REVOKED
  accessTokenHash  String    @map("access_token_hash") @db.VarChar(128)
  accessExpiresAt  DateTime  @map("access_expires_at")
  prevRefreshHash  String?   @map("prev_refresh_hash") @db.VarChar(128)
  refreshTokenHash String?   @map("refresh_token_hash") @db.VarChar(128)
  refreshExpiresAt DateTime? @map("refresh_expires_at")
  lastUsedAt       DateTime? @map("last_used_at")
  rotatedAt        DateTime? @map("rotated_at")
  ip               String?   @db.VarChar(64)
  createdAt        DateTime  @default(now()) @map("created_at")
  revokedAt        DateTime? @map("revoked_at")

  @@index([accessTokenHash])
  @@index([userId])
  @@map("oauth_grants")
}

/// 组织级三方平台服务集成（INTG-001/002：地址+凭据密文；一组织一平台一条）
model PlatformIntegration {
  id          String       @id @default(uuid())
  orgId       String       @map("org_id")
  org         Organization @relation(fields: [orgId], references: [id])
  platform    String       @db.VarChar(32) // jira | zentao | tapd
  address     String       @db.VarChar(512)
  authType    String       @db.VarChar(16) // BASIC | BEARER（jira）；zentao/tapd 固定 BASIC 语义
  credential  String // AES-256-GCM 密文（env RABBIT_INTEGRATION_SECRET 派生密钥；永不回显）
  testStatus  String       @default("NONE") @db.VarChar(16) // NONE | OK | FAILED
  testMessage String?      @map("test_message") @db.VarChar(512)
  testedAt    DateTime?    @map("tested_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@unique([orgId, platform])
  @@map("platform_integrations")
}

model SystemParam {
  key       String   @id @db.VarChar(64)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_params")
}

model License {
  id        String   @id @default(uuid())
  code      String   @db.VarChar(4096)
  status    String   @default("NONE") @db.VarChar(32) // NONE | VALID | EXPIRED（ENTP-007）
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("licenses")
}

// ───────────────────────── project 域 ─────────────────────────

model ModuleNode {
  id             String           @id @default(uuid())
  projectId      String           @map("project_id")
  project        Project          @relation(fields: [projectId], references: [id])
  scene          String           @db.VarChar(16) // case | api | scenario | bug | file
  parentId       String?          @map("parent_id")
  parent         ModuleNode?      @relation("ModuleTree", fields: [parentId], references: [id])
  children       ModuleNode[]     @relation("ModuleTree")
  name           String           @db.VarChar(128)
  isDefault      Boolean          @default(false) @map("is_default") // 默认根「未规划用例/接口」
  order          Int              @default(0)
  cases          FunctionalCase[]
  apiDefinitions ApiDefinition[]
  scenarios      Scenario[]
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@index([projectId, scene])
  @@map("module_nodes")
}

model FieldDef {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  projectId String?  @map("project_id")
  scene     String   @db.VarChar(16) // case | bug | api
  name      String   @db.VarChar(128)
  key       String   @db.VarChar(64)
  type      String   @db.VarChar(32) // input|textarea|number|date|single_select|multi_select|checkbox|radio|member|url
  required  Boolean  @default(false)
  options   Json     @default("{}")
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([scene, key, orgId])
  @@map("field_defs")
}

model Template {
  id              String   @id @default(uuid())
  orgId           String   @map("org_id")
  projectId       String?  @map("project_id")
  scene           String   @db.VarChar(16)
  name            String   @db.VarChar(128)
  isDefault       Boolean  @default(false) @map("is_default")
  isSystem        Boolean  @default(false) @map("is_system")
  fields          Json     @default("[]") // [{fieldKey, required, visibleInList}]
  platformBinding Json     @default("{}") @map("platform_binding")
  bugs            Bug[]
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([scene, projectId])
  @@map("templates")
}

model WorkflowState {
  id            String               @id @default(uuid())
  templateId    String               @map("template_id")
  scene         String               @db.VarChar(16)
  serial        String               @db.VarChar(64)
  isStart       Boolean              @default(false) @map("is_start")
  isEnd         Boolean              @default(false) @map("is_end")
  transitions   WorkflowTransition[] @relation("FromState")
  toTransitions WorkflowTransition[] @relation("ToState")

  @@unique([templateId, serial])
  @@map("workflow_states")
}

model WorkflowTransition {
  id          String        @id @default(uuid())
  fromStateId String        @map("from_state_id")
  fromState   WorkflowState @relation("FromState", fields: [fromStateId], references: [id])
  toStateId   String        @map("to_state_id")
  toState     WorkflowState @relation("ToState", fields: [toStateId], references: [id])

  @@unique([fromStateId, toStateId])
  @@map("workflow_transitions")
}

model Environment {
  id        String    @id @default(uuid())
  projectId String    @map("project_id")
  project   Project   @relation(fields: [projectId], references: [id])
  name      String    @db.VarChar(128)
  config    Json // {vars, http[], database[], hosts, prePost, asserts, tcp}
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([projectId, deletedAt])
  @@map("environments")
}

model EnvGroup {
  id             String   @id @default(uuid())
  projectId      String   @map("project_id")
  project        Project  @relation(fields: [projectId], references: [id])
  name           String   @db.VarChar(128)
  environmentIds Json     @default("[]") @map("environment_ids")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("env_groups")
}

model GlobalParam {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id])
  params    Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([projectId])
  @@map("global_params")
}

model FileItem {
  id         String    @id @default(uuid())
  projectId  String    @map("project_id")
  project    Project   @relation(fields: [projectId], references: [id])
  moduleId   String?   @map("module_id")
  name       String    @db.VarChar(256)
  storageKey String    @map("storage_key") @db.VarChar(512)
  size       Int
  mime       String?   @db.VarChar(128)
  jarEnabled Boolean   @default(false) @map("jar_enabled")
  repoId     String?   @map("repo_id")
  repo       FileRepo? @relation(fields: [repoId], references: [id])
  /// S5 FILE-001 仓库文件溯源列（门禁 3 例外登记：test-domain-model §6 S5 条目）
  branch     String?   @db.VarChar(128)
  repoPath   String?   @map("repo_path") @db.VarChar(512)
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([projectId, deletedAt])
  @@index([repoId])
  @@map("file_items")
}

model FileRepo {
  id        String     @id @default(uuid())
  projectId String     @map("project_id")
  project   Project    @relation(fields: [projectId], references: [id])
  platform  String     @db.VarChar(32) // gitea | github | gitlab | gitee
  url       String     @db.VarChar(1024)
  token     String?    @db.VarChar(512)
  createdAt DateTime   @default(now()) @map("created_at")
  files     FileItem[]

  @@map("file_repos")
}

// ───────────────────────── scm 域（SCM-001 项目代码仓库） ─────────────────────────

/// 组织级代码平台 OAuth App 覆盖（SCM-001 §4.1：未配置时继承 SystemParam group=scm；一组织一平台一条）
model ScmOrgApp {
  id            String       @id @default(uuid())
  orgId         String       @map("org_id")
  org           Organization @relation(fields: [orgId], references: [id])
  provider      String       @db.VarChar(32) // github | gitee | gitlab（OAuth 三平台）
  /// GitLab 实例地址（自建）；github/gitee 为空（官方域）
  baseUrl       String?      @db.VarChar(512) @map("base_url")
  clientId      String       @db.VarChar(255) @map("client_id")
  /// client_secret AES-256-GCM 密文（credential-crypto 命名空间 scm-app:{provider}；永不回显）
  clientSecret  String       @db.VarChar(512) @map("client_secret")
  enabled       Boolean      @default(true)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@unique([orgId, provider])
  @@map("scm_org_apps")
}

/// 组织内成员 OAuth 授权账号（凭据在账号上，项目绑定时引用；撤销后绑定变凭据失效）
model ScmAccount {
  id              String       @id @default(uuid())
  orgId           String       @map("org_id")
  org             Organization @relation(fields: [orgId], references: [id])
  /// 授权人（发起 OAuth 的组织成员）
  userId          String       @map("user_id")
  user            User         @relation(fields: [userId], references: [id])
  provider        String       @db.VarChar(32) // github | gitee | gitlab
  baseUrl         String?      @db.VarChar(512) @map("base_url")
  /// 平台登录名/昵称/头像（GET /user 拉取，展示用）
  login           String       @db.VarChar(255)
  name            String?      @db.VarChar(255)
  avatarUrl       String?      @db.VarChar(1024) @map("avatar_url")
  /// access_token AES-256-GCM 密文（命名空间 scm-account:{provider}）
  tokenEnc        String       @db.VarChar(1024) @map("token_enc")
  /// refresh_token 密文（GitLab 2h 过期需旋转；github/gitee 为空）
  refreshTokenEnc String?      @db.VarChar(1024) @map("refresh_token_enc")
  expiresAt       DateTime?    @map("expires_at")
  scopes          String?      @db.VarChar(255)
  status          String       @default("ACTIVE") @db.VarChar(16) // ACTIVE | EXPIRED | REVOKED
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")
  repositories    ScmRepository[]

  @@unique([orgId, userId, provider])
  @@index([orgId, deletedAt])
  @@map("scm_accounts")
}

/// 项目代码仓库绑定（核心表；defaultBranch/visibility 为元信息列，一次建齐）
model ScmRepository {
  id             String       @id @default(uuid())
  projectId      String       @map("project_id")
  project        Project      @relation(fields: [projectId], references: [id])
  /// 展示别名；空=owner/repo
  name           String?      @db.VarChar(128)
  provider       String       @db.VarChar(32) // github | gitee | gitlab | gitea | custom
  /// 原始仓库地址（https 或 ssh）
  repoUrl        String       @db.VarChar(1024) @map("repo_url")
  /// ssh 克隆地址（OAuth 选仓时平台返回；直填 https 时为空）
  sshUrl         String?      @db.VarChar(1024) @map("ssh_url")
  host           String       @db.VarChar(255)
  owner          String       @db.VarChar(255)
  repo           String       @db.VarChar(255)
  /// 平台 REST API 基址（解析缓存；custom 为空=不验证）
  apiBase        String?      @db.VarChar(512) @map("api_base")
  authType       String       @db.VarChar(16) @map("auth_type") // none | oauth | token | password
  /// authType=oauth 时引用授权账号
  accountId      String?      @map("account_id")
  account        ScmAccount?  @relation(fields: [accountId], references: [id])
  /// authType=password 时用户名
  username       String?      @db.VarChar(255)
  /// token/password 的 AES-256-GCM 密文（命名空间 scm-repo:{provider}；永不回显）
  secretEnc      String?      @db.VarChar(512) @map("secret_enc")
  /// 元信息（verify 刷新；未启用列一次建齐）
  defaultBranch  String?      @db.VarChar(255) @map("default_branch")
  visibility     String?      @db.VarChar(16) // public | private | internal
  isDefault      Boolean      @default(false) @map("is_default")
  verifyStatus   String       @default("UNVERIFIED") @db.VarChar(16) @map("verify_status") // UNVERIFIED | OK | INVALID_CRED | FAILED
  verifyMessage  String?      @db.VarChar(512) @map("verify_message")
  lastVerifiedAt DateTime?    @map("last_verified_at")
  createdById    String       @map("created_by_id")
  createdBy      User         @relation(fields: [createdById], references: [id])
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  @@index([projectId, deletedAt])
  @@map("scm_repositories")
}

model PublicScript {
  id        String    @id @default(uuid())
  projectId String    @map("project_id")
  project   Project   @relation(fields: [projectId], references: [id])
  name      String    @db.VarChar(128)
  language  String    @default("javascript") @db.VarChar(32)
  status    String    @default("DRAFT") @db.VarChar(32)
  tags      Json      @default("[]")
  params    Json      @default("[]")
  content   String
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("public_scripts")
}

model FalseAlarmRule {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id])
  name      String   @db.VarChar(128)
  matcher   Json // {status?, bodyContains?...}
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("false_alarm_rules")
}

model AppSetting {
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id])
  key       String   @db.VarChar(64)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([projectId, key])
  @@map("app_settings")
}

/// 用户偏好（CASE-002 视图/列配置、CASE-003 Tab 记忆、DASH-001 卡片布局；projectId="" 为全局）
model UserPreference {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  projectId String   @default("") @map("project_id")
  key       String   @db.VarChar(64) // case_views | case_columns | case_tab | dash_cards
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, projectId, key])
  @@map("user_preferences")
}

// ───────────────────────── case 域 ─────────────────────────

model FunctionalCase {
  id           String     @id @default(uuid())
  projectId    String     @map("project_id")
  project      Project    @relation(fields: [projectId], references: [id])
  moduleId     String     @map("module_id")
  module       ModuleNode @relation(fields: [moduleId], references: [id])
  num          Int
  name         String     @db.VarChar(512)
  precondition String     @db.VarChar(4000)
  steps        Json       @default("[]") // [{desc, expect}]
  level        String     @default("P2") @db.VarChar(8)
  status       String     @default("PREPARING") @db.VarChar(32)
  tags         Json       @default("[]")
  templateId   String?    @map("template_id")
  fields       Json       @default("{}") // 自定义字段值（Sprint 1）
  version      Int        @default(1)
  deletedAt    DateTime?  @map("deleted_at")
  createdBy    String     @map("created_by")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  reviewCases ReviewCase[]
  apiRefs     CaseApiRef[]

  @@unique([projectId, num])
  @@index([projectId, deletedAt, name])
  @@index([projectId, deletedAt, level])
  @@index([moduleId, deletedAt])
  @@map("functional_cases")
}

model CaseReview {
  id          String       @id @default(uuid())
  projectId   String       @map("project_id")
  name        String       @db.VarChar(256)
  description String?      @db.VarChar(2000)
  /// 创建人（「我创建的」视图口径，CASE-005）
  createdBy   String       @default("") @map("created_by")
  reviewMode  String       @default("SINGLE") @map("review_mode") @db.VarChar(16) // SINGLE | MULTI
  reviewers   Json         @default("[]")
  startAt     DateTime?    @map("start_at")
  endAt       DateTime?    @map("end_at")
  status      String       @default("UNDERWAY") @db.VarChar(32)
  deletedAt   DateTime?    @map("deleted_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  cases       ReviewCase[]

  @@map("case_reviews")
}

model ReviewCase {
  id          String         @id @default(uuid())
  reviewId    String         @map("review_id")
  review      CaseReview     @relation(fields: [reviewId], references: [id])
  caseId      String         @map("case_id")
  case        FunctionalCase @relation(fields: [caseId], references: [id])
  reviewer    String?        @db.VarChar(64)
  result      String?        @db.VarChar(32)
  /// 逐评审人标记 [{userId,result,comment,ts}]（multi 模式聚合，CASE-005）
  results     Json           @default("[]")
  /// 该用例的评审人（批量改评审人；缺省继承评审级 reviewers，CASE-005）
  reviewers   Json           @default("[]")
  reSubmit    Boolean        @default(false) @map("re_submit")
  commentedAt DateTime?      @map("commented_at")

  @@unique([reviewId, caseId])
  @@map("review_cases")
}

model CaseDependency {
  id         String @id @default(uuid())
  preCaseId  String @map("pre_case_id")
  postCaseId String @map("post_case_id")

  @@unique([preCaseId, postCaseId])
  @@map("case_dependencies")
}

model CaseDemandRef {
  id         String @id @default(uuid())
  caseId     String @map("case_id")
  platform   String @db.VarChar(32) // jira | zentao | tapd
  demandKey  String @map("demand_key") @db.VarChar(128)
  demandJson Json?  @map("demand_json")

  @@unique([caseId, platform, demandKey])
  @@map("case_demand_refs")
}

/// 用例关联接口（CASE-006；refType ∈ api_case | scenario——跨域经 Provider，test-domain-model §3）
model CaseApiRef {
  id      String         @id @default(uuid())
  caseId  String         @map("case_id")
  case    FunctionalCase @relation(fields: [caseId], references: [id])
  refType String         @default("api_case") @map("ref_type") @db.VarChar(32)
  refId   String         @map("ref_id")
  config  Json           @default("{}")

  @@unique([caseId, refType, refId])
  @@index([refType, refId])
  @@map("case_api_refs")
}

// ── 通用横切（Comment / ChangeLog / Follow）──

model Comment {
  id         String    @id @default(uuid())
  entityType String    @map("entity_type") @db.VarChar(64)
  entityId   String    @map("entity_id")
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id])
  content    String    @db.VarChar(4000)
  mentions   Json      @default("[]")
  parentId   String?   @map("parent_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@index([entityType, entityId, createdAt])
  @@map("comments")
}

model ChangeLog {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type") @db.VarChar(64)
  entityId   String   @map("entity_id")
  seq        Int
  action     String   @db.VarChar(32) // create | update | delete | restore
  diff       Json?
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([entityType, entityId, seq])
  @@index([entityType, entityId, createdAt])
  @@map("change_logs")
}

model Follow {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  entityType String   @map("entity_type") @db.VarChar(64)
  entityId   String   @map("entity_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, entityType, entityId])
  @@map("follows")
}

// ───────────────────────── plan 域 ─────────────────────────

model TestPlan {
  id          String        @id @default(uuid())
  projectId   String        @map("project_id")
  project     Project       @relation(fields: [projectId], references: [id])
  /// 计划组：groupId 指向同表 type=GROUP 记录（xpack 语义列，P0 建齐不启用）
  groupId     String?       @map("group_id")
  type        String        @default("PLAN") @db.VarChar(8) // PLAN | GROUP
  name        String        @db.VarChar(256)
  description String?       @db.VarChar(2000)
  moduleId    String?       @map("module_id")
  startAt     DateTime?     @map("start_at")
  endAt       DateTime?     @map("end_at")
  tags        Json          @default("[]")
  settings    Json          @default("{}") // {threshold, allowDuplicate, autoUpdateStatus}
  status      String        @default("NOT_STARTED") @db.VarChar(32)
  archivedAt  DateTime?     @map("archived_at")
  deletedAt   DateTime?     @map("deleted_at")
  createdBy   String        @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  points      TestPoint[]
  caseRefs    PlanCaseRef[]

  @@index([projectId, deletedAt])
  @@map("test_plans")
}

model TestPoint {
  id            String        @id @default(uuid())
  planId        String        @map("plan_id")
  plan          TestPlan      @relation(fields: [planId], references: [id])
  parentId      String?       @map("parent_id")
  parent        TestPoint?    @relation("PointTree", fields: [parentId], references: [id])
  children      TestPoint[]   @relation("PointTree")
  name          String        @db.VarChar(256)
  inheritConfig Boolean       @default(true) @map("inherit_config")
  config        Json          @default("{}")
  order         Int           @default(0)
  caseRefs      PlanCaseRef[]

  @@map("test_points")
}

/// 多态引用：refType ∈ functional_case | api_case | scenario（跨域经 Provider，test-domain-model §3）
model PlanCaseRef {
  id          String     @id @default(uuid())
  planId      String     @map("plan_id")
  plan        TestPlan   @relation(fields: [planId], references: [id])
  pointId     String?    @map("point_id")
  point       TestPoint? @relation(fields: [pointId], references: [id])
  refType     String     @map("ref_type") @db.VarChar(32)
  refId       String     @map("ref_id")
  config      Json       @default("{}") // {envId, poolId, serial, stopOnFail}
  execUserId  String?    @map("exec_user_id")
  status      String     @default("NOT_RUN") @db.VarChar(32) // NOT_RUN|PASS|FAIL|BLOCKED|SKIPPED
  /// 本次执行结果 {actualResult, steps:[{status,result}], comment}（PLAN-001）
  result      Json       @default("{}")
  /// 执行历史 [{ts,userId,from,to,steps}]（PLAN-001）
  execHistory Json       @default("[]") @map("exec_history")

  @@unique([planId, refType, refId])
  @@index([refType, refId])
  @@map("plan_case_refs")
}

// ───────────────────────── bug 域 ─────────────────────────

model Bug {
  id           String       @id @default(uuid())
  projectId    String       @map("project_id")
  project      Project      @relation(fields: [projectId], references: [id])
  templateId   String?      @map("template_id")
  num          Int
  title        String       @db.VarChar(512)
  description  String       @db.VarChar(8000)
  fields       Json         @default("{}")
  /// 当前工作流状态（WorkflowState.serial；模板内 serial 唯一——BUG-001）
  status       String       @default("") @db.VarChar(64)
  handleUserId String?      @map("handle_user_id") // 处理人（BUG-001）
  moduleId     String?      @map("module_id") // bug 场景模块树（BUG-001）
  tags         Json         @default("[]")
  platform     String       @default("LOCAL") @db.VarChar(32)
  platformKey  String?      @map("platform_key") @db.VarChar(128)
  syncState    String       @default("NONE") @map("sync_state") @db.VarChar(32)
  template     Template?    @relation(fields: [templateId], references: [id])
  version      Int          @default(1)
  deletedAt    DateTime?    @map("deleted_at")
  createdBy    String       @map("created_by")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  caseRefs     BugCaseRef[]

  @@unique([projectId, num])
  @@index([projectId, deletedAt])
  @@map("bugs")
}

/// 通用附件横切（BUG-001；entityType 形如 bug:{id}）
model Attachment {
  id         String    @id @default(uuid())
  projectId  String    @map("project_id")
  project    Project   @relation(fields: [projectId], references: [id])
  entityType String    @map("entity_type") @db.VarChar(64)
  entityId   String    @map("entity_id")
  name       String    @db.VarChar(256)
  storageKey String    @map("storage_key") @db.VarChar(512)
  size       Int
  mime       String?   @db.VarChar(128)
  createdBy  String    @map("created_by")
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([projectId, deletedAt])
  @@map("attachments")
}

model BugCaseRef {
  id      String @id @default(uuid())
  bugId   String @map("bug_id")
  bug     Bug    @relation(fields: [bugId], references: [id])
  refType String @map("ref_type") @db.VarChar(32)
  refId   String @map("ref_id")

  @@unique([bugId, refType, refId])
  @@map("bug_case_refs")
}

model PlatformSyncConfig {
  id         String   @id @default(uuid())
  projectId  String   @unique @map("project_id")
  platform   String   @db.VarChar(32)
  projectKey String?  @map("project_key") @db.VarChar(128)
  bugTypes   Json     @default("[]") @map("bug_types")
  mode       String   @default("INCREMENT") @db.VarChar(16)
  cron       String?  @db.VarChar(64)
  enabled    Boolean  @default(false)
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("platform_sync_configs")
}

// ───────────────────────── api_test 域 ─────────────────────────

model ApiDefinition {
  id        String     @id @default(uuid())
  projectId String     @map("project_id")
  project   Project    @relation(fields: [projectId], references: [id])
  moduleId  String     @map("module_id")
  module    ModuleNode @relation(fields: [moduleId], references: [id])
  num       Int
  protocol  String     @default("HTTP") @db.VarChar(32)
  method    String     @db.VarChar(16)
  path      String     @db.VarChar(1024)
  name      String     @db.VarChar(512)
  status    String     @default("DEBUG") @db.VarChar(32)
  version   Int        @default(1)
  request   Json
  response  Json       @default("{}")
  deletedAt DateTime?  @map("deleted_at")
  createdBy String     @map("created_by")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  cases     ApiCase[]
  mocks     ApiMock[]

  @@unique([projectId, num])
  @@index([projectId, deletedAt, name])
  @@map("api_definitions")
}

model ApiCase {
  id            String        @id @default(uuid())
  apiId         String        @map("api_id")
  api           ApiDefinition @relation(fields: [apiId], references: [id])
  projectId     String        @map("project_id")
  project       Project       @relation(fields: [projectId], references: [id])
  num           Int
  name          String        @db.VarChar(512)
  level         String        @default("P2") @db.VarChar(8)
  status        String        @default("UNDERWAY") @db.VarChar(32)
  tags          Json          @default("[]")
  request       Json // { spec, asserts, pre, post, extracts }（API-004 契约 v2 请求包）
  version       Int           @default(1)
  /// 基线定义 version（API-003 差异同步；定义 bump 超前→「待同步」）
  syncedVersion Int           @default(0) @map("synced_version")
  deletedAt     DateTime?     @map("deleted_at")
  createdBy     String        @map("created_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@unique([projectId, num])
  @@map("api_cases")
}

model ApiMock {
  id        String        @id @default(uuid())
  apiId     String        @map("api_id")
  api       ApiDefinition @relation(fields: [apiId], references: [id])
  name      String        @db.VarChar(256)
  matchers  Json
  response  Json
  followApi Boolean       @default(false) @map("follow_api")
  enabled   Boolean       @default(true)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@map("api_mocks")
}

model Scenario {
  id        String         @id @default(uuid())
  projectId String         @map("project_id")
  project   Project        @relation(fields: [projectId], references: [id])
  moduleId  String         @map("module_id")
  module    ModuleNode     @relation(fields: [moduleId], references: [id])
  num       Int
  name      String         @db.VarChar(512)
  level     String         @default("P2") @db.VarChar(8)
  status    String         @default("UNDERWAY") @db.VarChar(32)
  tags      Json           @default("[]")
  /// 五配置区：params / prePost / asserts / settings（步骤在 ScenarioStep 树）
  config    Json           @default("{}")
  version   Int            @default(1)
  deletedAt DateTime?      @map("deleted_at")
  createdBy String         @map("created_by")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  steps     ScenarioStep[]

  @@unique([projectId, num])
  @@map("scenarios")
}

model ScenarioStep {
  id         String         @id @default(uuid())
  scenarioId String         @map("scenario_id")
  scenario   Scenario       @relation(fields: [scenarioId], references: [id])
  parentId   String?        @map("parent_id")
  parent     ScenarioStep?  @relation("StepTree", fields: [parentId], references: [id])
  children   ScenarioStep[] @relation("StepTree")
  stepType   String         @map("step_type") @db.VarChar(32) // ref_api|ref_case|ref_scenario|custom|loop|condition|once|script|wait
  refId      String?        @map("ref_id")
  name       String         @db.VarChar(256)
  config     Json           @default("{}")
  enabled    Boolean        @default(true)
  order      Int            @default(0)

  @@index([scenarioId, parentId])
  @@map("scenario_steps")
}

// ───────────────────────── exec / report 域 ─────────────────────────

model ExecTask {
  id             String          @id @default(uuid())
  projectId      String          @map("project_id")
  project        Project         @relation(fields: [projectId], references: [id])
  type           String          @db.VarChar(32) // api_debug | api_case | scenario | plan | load | ui_case | ui_batch（S11）| ui_validate（S13 脚本校验干跑）
  refType        String?         @map("ref_type") @db.VarChar(32)
  refId          String?         @map("ref_id") @db.VarChar(64)
  status         String          @default("PENDING") @db.VarChar(16)
  clientTaskId   String?         @map("client_task_id") @db.VarChar(128)
  poolId         String?         @map("pool_id")
  pool           ResourcePool?   @relation(fields: [poolId], references: [id])
  envId          String?         @map("env_id")
  payload        Json // 执行定义（request/asserts 等）
  failureKind    String?         @map("failure_kind") @db.VarChar(32)
  message        String?         @db.VarChar(2000)
  startedAt      DateTime?       @map("started_at")
  finishedAt     DateTime?       @map("finished_at")
  durationMs     Int?            @map("duration_ms")
  createdBy      String          @map("created_by")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  items          ExecItem[]
  reports        Report[]
  falseAlarmHits FalseAlarmHit[]

  @@unique([projectId, clientTaskId])
  @@index([projectId, type, createdAt])
  @@index([status])
  @@map("exec_tasks")
}

model ExecItem {
  id          String           @id @default(uuid())
  taskId      String           @map("task_id")
  task        ExecTask         @relation(fields: [taskId], references: [id])
  refType     String           @map("ref_type") @db.VarChar(32)
  refId       String           @map("ref_id")
  status      String           @default("PENDING") @db.VarChar(16)
  result      Json? // 汇总摘要（通过率等在此冗余列聚合）
  startedAt   DateTime?        @map("started_at")
  finishedAt  DateTime?        @map("finished_at")
  stepResults ExecStepResult[]

  @@index([taskId])
  @@map("exec_items")
}

model ExecStepResult {
  id        String   @id @default(uuid())
  itemId    String   @map("item_id")
  item      ExecItem @relation(fields: [itemId], references: [id])
  seq       Int
  frame     Json // 事件帧原样持久化（报告=事件视图）
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([itemId, seq])
  @@map("exec_step_results")
}

model Report {
  id             String          @id @default(uuid())
  taskId         String          @map("task_id")
  task           ExecTask        @relation(fields: [taskId], references: [id])
  projectId      String          @map("project_id")
  project        Project         @relation(fields: [projectId], references: [id])
  planId         String?         @map("plan_id")
  reportType     String          @map("report_type") @db.VarChar(32) // api_case | scenario | plan | load | ui（S11）| ui_case/ui_batch/ui_validate（S13 脚本模式与校验干跑）
  name           String          @db.VarChar(256)
  summary        String?         @db.VarChar(4000)
  snapshot       Json? // 分享快照（P0 不启用）
  createdBy      String          @map("created_by")
  createdAt      DateTime        @default(now()) @map("created_at")
  shares         ReportShare[]
  falseAlarmHits FalseAlarmHit[]

  @@index([projectId, createdAt])
  @@map("reports")
}

model ReportShare {
  id        String   @id @default(uuid())
  reportId  String   @map("report_id")
  report    Report   @relation(fields: [reportId], references: [id])
  token     String   @unique @db.VarChar(128)
  expireAt  DateTime @map("expire_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("report_shares")
}

model FalseAlarmHit {
  id        String   @id @default(uuid())
  reportId  String   @map("report_id")
  report    Report   @relation(fields: [reportId], references: [id])
  taskId    String   @map("task_id")
  task      ExecTask @relation(fields: [taskId], references: [id])
  ruleId    String   @map("rule_id") @db.VarChar(64)
  /// 规则名冗余（S3 API-010：规则删除后留痕名称仍可展示——门禁 3 评审补齐）
  ruleName  String   @map("rule_name") @db.VarChar(128)
  stepPath  String?  @map("step_path") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("false_alarm_hits")
}

/// AI 模型配置（系统级；apiKey AES-256-GCM 密文，密钥自 SESSION_SECRET 派生——AI-001）
model AiModel {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(64)
  provider  String   @db.VarChar(32) // deepseek | openai | zhipu
  baseUrl   String   @map("base_url") @db.VarChar(255)
  model     String   @db.VarChar(128)
  apiKeyEnc String   @map("api_key_enc")
  enabled   Boolean  @default(true)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ai_models")
}

/// AI 助手会话（个人级软删；30 天清理——AI-004）
model AiConversation {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  title     String    @db.VarChar(128)
  modelId   String?   @map("model_id") @db.VarChar(64)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

/// AI 助手消息（content 结构化 {text}，预留 refs——AI-004）
model AiMessage {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  role           String   @db.VarChar(16) // user | assistant
  content        Json
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

/// 项目级提示词模板（同 scene 默认唯一——AI-005）
model AiPromptTemplate {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id")
  name         String   @db.VarChar(64)
  scene        String   @db.VarChar(32) // case_gen | api_gen
  template     String   @db.Text
  designMethod String?  @map("design_method") @db.VarChar(128)
  isDefault    Boolean  @default(false) @map("is_default")
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([projectId, name])
  @@map("ai_prompt_templates")
}

/// AI 生成留痕（prompt 快照全文；裸列不级联——AI-002/003）
model AiGenRecord {
  id             String   @id @default(uuid())
  projectId      String   @map("project_id")
  userId         String   @map("user_id")
  modelId        String   @map("model_id") @db.VarChar(64)
  scene          String   @db.VarChar(32) // case_gen | api_gen | api_gen_batch
  generatedCount Int      @default(0) @map("generated_count")
  importedCount  Int      @default(0) @map("imported_count")
  promptSnapshot Json     @map("prompt_snapshot")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([projectId, createdAt])
  @@map("ai_gen_records")
}

/// S11 LOAD-003 施压计划（企业版 License 门控；任务复用 ExecTask(type=load)、秒级时间线载于 Report.summary Json——门禁 3 对齐 LOAD-002 §2）
model LoadTest {
  id         String    @id @default(uuid())
  projectId  String    @map("project_id")
  project    Project   @relation(fields: [projectId], references: [id])
  name       String    @db.VarChar(128)
  status     String    @default("ACTIVE") @db.VarChar(16)
  /// 目标 HTTP 请求（method/url/headers/body，zod 校验）
  target     Json
  /// 压力模型（mode=concurrency|tps、durationSec、ramp 阶梯数组、maxConcurrency/targetTps）
  pressure   Json
  /// 断言阈值（okRateMin/p95MsMax/avgMsMax，结论判定）
  thresholds Json
  envId      String?   @map("env_id")
  createdBy  String    @map("created_by")
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([projectId, deletedAt])
  @@map("load_tests")
}

/// S11 UIT-002 元素库（定位器仓库；删除后用例引用悬空→执行时 CONFIG_ERROR，不级联删用例）
model UiElement {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  project     Project   @relation(fields: [projectId], references: [id])
  name        String    @db.VarChar(128)
  locatorType String    @map("locator_type") @db.VarChar(16) // css | xpath | testid | text | role
  locator     String    @db.VarChar(512)
  description String?   @db.VarChar(512)
  moduleId    String?   @map("module_id")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([projectId, deletedAt])
  @@map("ui_elements")
}

/// S11 UIT-002 UI 用例；S13 UIT-003 增 mode/script/params（script=Playwright 脚本直录直执行；执行=ExecTask(type=ui_case|ui_batch|ui_validate)+chromium）
model UiTestCase {
  id        String    @id @default(uuid())
  projectId String    @map("project_id")
  project   Project   @relation(fields: [projectId], references: [id])
  name      String    @db.VarChar(128)
  /// v6/S13 UIT-003：模式二态——steps=指令序列（UIT-002）/script=Playwright 脚本直录；缺省 steps 兼容存量
  mode      String    @default("steps") @db.VarChar(16)
  /// 步骤序列（上限 50，zod 校验；script 模式恒存 []）
  steps     Json
  /// 标准 Playwright Test 脚本（script 模式；≤100KB）
  script    String?
  /// 参数 KV（script 模式注入子进程 env RABBIT_PARAM_*）
  params    Json      @default("[]")
  timeoutMs Int       @default(15000) @map("timeout_ms")
  createdBy String    @map("created_by")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([projectId, deletedAt])
  @@map("ui_test_cases")
}

/// S14 UIT-004：项目级 UI Runner（内置 runner 不入表，运行时从引擎常量推导）。
/// 隔离：projectId 必填（API 层 withProjectScope 404 防枚举 + 磁盘 .runners/{projectId}/{runnerId}/ 分域 + 引擎归属校验）。
model UiRunner {
  id             String    @id @default(uuid())
  projectId      String    @map("project_id")
  project        Project   @relation(fields: [projectId], references: [id])
  name           String    @db.VarChar(64)
  /// 恒 project（内置=builtin 不入表；预留组织共享 P2）
  kind           String    @default("project") @db.VarChar(16)
  /// 精确 semver（安装时锁定；RUNNER_VERSION_RE 白名单）
  version        String    @db.VarChar(32)
  /// INSTALLING | READY | FAILED | INSTALL_CANCELLED
  status         String    @default("INSTALLING") @db.VarChar(32)
  /// 项目内至多一个默认（事务内先清后置）
  isDefault      Boolean   @default(false) @map("is_default")
  /// npm/浏览器安装输出尾部（失败定位；≤2000 字）
  installLogTail String?   @map("install_log_tail")
  /// 最近检测完成时间（引擎实测回调回写）
  lastCheckAt    DateTime? @map("last_check_at")
  /// 检测快照 runnerCheckResultSchema {items,checkedAt,version}
  checkItems     Json?     @map("check_items")
  /// P2 预留：多浏览器矩阵 {chromium,firefox,webkit,revision}
  browsers       Json?     @map("browsers")
  /// 默认 https://registry.npmjs.org（P2 离线导入=local）
  installSource  String    @default("https://registry.npmjs.org") @map("install_source") @db.VarChar(255)
  createdById    String    @map("created_by")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([projectId, deletedAt])
  @@map("ui_runners")
}
