{
  "name": "rabbitaitest",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "oxfmt --ignore-path .oxfmtignore --write . || (echo \"[format] oxfmt 缺失，自动安装…\" && pnpm install && oxfmt --ignore-path .oxfmtignore --write .)",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test -c tests/playwright.config.ts",
    "test:api": "bash scripts/run-api-tests.sh",
    "db:generate": "pnpm --filter @rabbit/db generate",
    "db:migrate": "pnpm --filter @rabbit/db migrate-deploy",
    "db:migrate-dev": "pnpm --filter @rabbit/db migrate-dev",
    "db:seed": "pnpm --filter @rabbit/db seed",
    "prepare": "husky",
    "postinstall": "node scripts/fix-embedded-pg.mjs || true",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "build:plugins": "node scripts/build-plugins.mjs",
    "test:visual": "playwright test -c tests/playwright.config.ts VISUAL",
    "visual:diff": "node scripts/visual-diff.mjs --enforce",
    "perf:seed": "node scripts/perf-seed.mjs",
    "perf:baseline": "node scripts/perf-baseline.mjs",
    "perf:baseline:quick": "node scripts/perf-baseline.mjs --scope quick",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.6.0",
    "@playwright/test": "^1.49.0",
    "commitlint": "^19.6.0",
    "embedded-postgres": "^17.5.0-beta.15",
    "esbuild": "^0.24.2",
    "husky": "^9.1.7",
    "oxfmt": "^0.70.0",
    "pg": "^8.23.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "undici": "^7.3.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.32.0",
  "pnpm": {
    "overrides": {
      "postcss@<8.5.18": ">=8.5.18 <9",
      "deepmerge-ts@<8.0.0": ">=8.0.0 <9"
    }
  }
}
